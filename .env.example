# Copy to .env for local runs; on Fly these are set with `fly secrets set`.
NFC_ENV=development
NFC_SECRET_KEY=generate-with-secrets.token_urlsafe-48
# Canonical public address once you have a domain (no trailing slash):
# NFC_PUBLIC_BASE_URL=https://reviewhere.in
# NFC_DB_PATH=/data/nfc.db
# NFC_SIGNUP_CLOSED=1
# NFC_SUPPORT_EMAIL=you@example.com

# Billing (Razorpay). Without these, billing pages render but no payment can be taken.
# NFC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# NFC_RAZORPAY_KEY_SECRET=xxxxxxxx
# NFC_RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# NFC_RAZORPAY_PLAN_ID=plan_xxxxxxxx
# NFC_TAG_PRICE_PAISE=30000        # Rs 300 per tag
# NFC_SUBSCRIPTION_PRICE_PAISE=49900   # Rs 499/month - must match the Razorpay plan
# NFC_TRIAL_DAYS=7
